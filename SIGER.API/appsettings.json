{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "None",
      "Microsoft.AspNetCore.Authentication": "None",
      "System.Net.Http.HttpClient": "None"
    }
  },
  "AllowedHosts": "*",
